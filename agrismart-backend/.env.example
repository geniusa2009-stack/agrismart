# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# MongoDB Atlas connection string (include db name in the path).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/agrismart?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_CONNECT_TIMEOUT_MS=30000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_SERVER_SELECTION_TIMEOUT_MS=20000
MONGO_HEARTBEAT_FREQUENCY_MS=10000
# true only in CI/test: fail fast if the initial connection fails.
DB_STARTUP_FAIL_FAST=false

CORS_ALLOWED_ORIGINS=https://app.agrismart.eg,https://admin.agrismart.eg
JSON_BODY_LIMIT=256kb

RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_DEVICE_WINDOW_MS=60000
RATE_LIMIT_DEVICE_MAX=120
RATE_LIMIT_COMMAND_WINDOW_MS=60000
RATE_LIMIT_COMMAND_MAX=10

# Generate real secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-hex-string-min-16-chars
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-char-hex-string
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL_DAYS=30

BCRYPT_SALT_ROUNDS=12

LOG_LEVEL=info

SHUTDOWN_TIMEOUT_MS=15000
SERVER_KEEP_ALIVE_TIMEOUT_MS=65000
SERVER_HEADERS_TIMEOUT_MS=66000
SERVER_REQUEST_TIMEOUT_MS=60000

IRRIGATION_MAX_DURATION_SECONDS=3600
IRRIGATION_DAILY_ALLOWANCE_SECONDS=7200
DEVICE_OFFLINE_THRESHOLD_SECONDS=300
COMMAND_EXPIRY_SECONDS=120

# Gemini agricultural copilot (ai/services/geminiCopilotService.js).
# Advisory-only: Gemini never executes irrigation commands directly.
# If GEMINI_API_KEY is unset, the copilot endpoint honestly returns
# { status: "unavailable" } instead of failing or fabricating a result.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
