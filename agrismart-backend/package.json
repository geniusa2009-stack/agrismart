{
  "name": "agrismart-backend",
  "version": "2.0.0",
  "description": "AgriSmart IoT & AI Smart Farming platform - secure, modular, observable, testable, IoT-ready backend (Node.js, Express, MongoDB) for high-latency, low-bandwidth rural network conditions.",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development LOG_LEVEL=debug node --watch src/server.js",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch",
    "ensure-indexes": "node src/infrastructure/database/indexes/ensureIndexes.js",
    "demo": "node scripts/startDemo.js",
    "test:offline": "cross-env NODE_ENV=test jest --config jest.offline.config.js",
    "ai:prepare": "node scripts/ai/prepare.js",
    "ai:train": "node scripts/ai/train.js",
    "ai:evaluate": "node scripts/ai/evaluate.js",
    "ai:predict": "node scripts/ai/predict.js",
    "bench:run": "node ai/external/benchmark/runBenchmark.js",
    "bench:cross": "node ai/external/benchmark/crossDatasetReport.js",
    "ai:tomato:train": "node ai/training/tomato/train.js",
    "ai:evolvingTomato:train": "node ai/training/evolvingTomato/train.js",
    "ai:arnesano:train": "node ai/training/arnesano/train.js"
  },
  "keywords": [
    "agrismart",
    "iot",
    "smart-farming",
    "express",
    "mongodb"
  ],
  "author": "AgriSmart Engineering Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@google/genai": "^2.24.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.3",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.1",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  }
}
