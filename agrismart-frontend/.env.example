# Copy this file to .env and adjust if needed. Never commit .env.

# Base URL of the AgriSmart backend API. Must match the backend's own
# PORT (see agrismart-backend/.env.example — 5001 by default in this
# project's local dev convention) and be included in the backend's
# CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=http://localhost:5001/api/v1
